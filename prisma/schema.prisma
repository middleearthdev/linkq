// LinkQ - Bio Link Platform Schema
// Complete schema for dynamic template system with premium features

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================
// ENUMS
// ====================================

enum SubscriptionTier {
  FREE
  STARTER  
  PRO
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserSiteStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ====================================
// USER MANAGEMENT
// ====================================

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String?
  avatar        String?
  
  // Authentication fields (Better Auth)
  emailVerified Boolean          @default(false)
  image         String?
  
  // Subscription info
  plan          SubscriptionTier @default(FREE)
  planExpiry    DateTime?
  customerId    String?          // Xendit customer ID
  
  // Admin access
  isAdmin       Boolean          @default(false)
  
  // Timestamps
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  
  // Relations
  sites         UserSite[]
  purchases     UserTemplatePurchase[]
  sessions      Session[]
  accounts      Account[]
  
  @@map("users")
  @@index([email])
  @@index([plan])
}

// ====================================
// AUTHENTICATION MODELS (Better Auth)
// ====================================

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("session")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  accountId         String
  providerId        String
  accessToken       String?
  refreshToken      String?
  idToken           String?  // OAuth ID token
  accessTokenExpiresAt DateTime?  // Token expiry
  refreshTokenExpiresAt DateTime? // Refresh token expiry
  scope             String?  // OAuth scopes
  expiresAt         DateTime?
  password          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([identifier, value])
  @@map("verification")
}

// ====================================
// TEMPLATE SYSTEM
// ====================================

model Template {
  id          String         @id @default(cuid())
  slug        String         @unique // e.g., "minimal", "aurora", "professional"
  name        String         // Display name
  description String?
  thumbnail   String?        // Preview image URL
  category    String?        // "free", "premium", "pro" (kept for backward compatibility)
  status      TemplateStatus @default(DRAFT)

  // New: Industry-specific categorization
  primaryCategory   String?  // 'creator', 'umkm', 'fnb', 'skincare', etc.
  subCategory       String?  // 'beauty-creator', 'fashion-umkm', 'cafe', etc.
  industryTags      String[] // ['food', 'instagram', 'ecommerce']
  targetAudience    String[] // ['influencer', 'small-business', 'entrepreneur']

  // Localization (JSON stored as JSONB in PostgreSQL)
  localizedName     Json?    // { en: 'Creator Template', id: 'Template Kreator' }
  localizedDesc     Json?    // { en: '...', id: '...' }

  // Features & use cases
  recommendedFor    String[] // Use cases: ['content-creator', 'online-shop', etc.]
  includesFeatures  String[] // ['whatsapp', 'gallery', 'testimonials', 'analytics']

  // Creator info (for marketplace)
  creatorId   String?
  creator     String?        // Creator name
  revenueShare Int?          // Percentage (0-100)

  // Timestamps
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  versions    TemplateVersion[]
  purchases   UserTemplatePurchase[]
  tags        TemplateTag[]

  @@map("templates")
  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([primaryCategory])
  @@index([subCategory])
}

model Tag {
  id          String    @id @default(cuid())
  name        String    @unique // e.g., "sport", "music", "business", "personal"
  slug        String    @unique // e.g., "sport", "music", "business", "personal" 
  description String?   // Optional description
  color       String?   // Hex color for UI display
  icon        String?   // Icon name or emoji
  
  // Categorization
  category    String?   // "industry", "style", "purpose", "audience"
  isPopular   Boolean   @default(false)
  sortOrder   Int       @default(0)
  
  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  templates   TemplateTag[]
  
  @@map("tags")
  @@index([slug])
  @@index([category])
  @@index([isPopular])
  @@index([sortOrder])
}

model TemplateTag {
  id         String   @id @default(cuid())
  templateId String
  tagId      String
  
  // Timestamps
  createdAt  DateTime @default(now())
  
  // Relations
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@map("template_tags")
  @@unique([templateId, tagId])
  @@index([templateId])
  @@index([tagId])
}

model TemplateVersion {
  id             String    @id @default(cuid())
  templateId     String
  version        String    // e.g., "1.0.0", "1.2.1"
  
  // Template configuration
  manifestJson   Json      // Layout, blocks, defaults
  cssVarsJson    Json      // CSS custom properties
  
  // Pricing & access
  isPaid         Boolean   @default(false)
  priceCents     Int?      // Price in cents (for one-time purchase)
  requiredPlan   SubscriptionTier? // Minimum required plan
  
  // Publishing
  isActive       Boolean   @default(false)
  publishedAt    DateTime?
  
  // Timestamps
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  // Relations
  template       Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sites          UserSite[]
  
  @@map("template_versions")
  @@unique([templateId, version])
  @@index([templateId])
  @@index([isActive])
  @@index([isPaid])
}

// ====================================
// BLOCK REGISTRY
// ====================================

model BlockDefinition {
  id          String   @id @default(cuid())
  type        String   @unique // e.g., "bio", "link-list", "social-icons"
  name        String   // Display name
  description String?
  category    String?  // "basic", "premium", "pro"
  
  // Configuration
  schemaJson  Json     // JSON Schema for validation
  defaultProps Json?   // Default properties
  
  // Premium features
  isPremium   Boolean  @default(false)
  requiredPlan SubscriptionTier? // Minimum required plan
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("block_definitions")
  @@index([type])
  @@index([isPremium])
}

// ====================================
// USER SITES
// ====================================

model UserSite {
  id          String         @id @default(cuid())
  userId      String
  handle      String         @unique // e.g., "johndoe"

  // Site configuration
  templateVersionId String
  dataJson    Json           // Block data and configuration
  customCss   String?        // Custom CSS (pro feature)

  // Background configuration (NEW)
  backgroundType    String?  @default("gradient-soft-clouds") // Key from background registry
  backgroundCustom  Json?    // Custom background config for advanced users
  backgroundImage   String?  // Uploaded background image URL

  // SEO & metadata
  title       String?
  description String?
  favicon     String?

  // Premium features
  customDomain String?       // Custom domain (pro feature)
  analyticsEnabled Boolean  @default(false)
  removeBranding Boolean    @default(false)

  // Status
  status      UserSiteStatus @default(DRAFT)
  publishedAt DateTime?

  // Timestamps
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id])
  analytics   SiteAnalytics[]
  customDomainConfig CustomDomain?
  webhooks    Webhook[]
  
  @@map("user_sites")
  @@index([userId])
  @@index([handle])
  @@index([status])
  @@index([customDomain])
}

// ====================================
// MARKETPLACE & PURCHASES
// ====================================

model UserTemplatePurchase {
  id              String         @id @default(cuid())
  userId          String
  templateId      String
  
  // Payment info
  priceCents      Int
  currency        String         @default("IDR")
  xenditInvoiceId String?        // Xendit invoice ID
  status          PurchaseStatus @default(PENDING)
  
  // Timestamps
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  // Relations
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  template        Template       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  @@map("user_template_purchases")
  @@unique([userId, templateId])
  @@index([userId])
  @@index([status])
}

// ====================================
// ANALYTICS (Premium Feature)
// ====================================

model SiteAnalytics {
  id          String   @id @default(cuid())
  siteId      String
  
  // Event data
  event       String   // "view", "click", "share"
  target      String?  // Block type or link URL
  referrer    String?
  userAgent   String?
  country     String?
  city        String?
  
  // Timestamps
  timestamp   DateTime @default(now())
  
  // Relations
  site        UserSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  
  @@map("site_analytics")
  @@index([siteId, timestamp])
  @@index([event])
}

// ====================================
// ADDITIONAL FEATURES
// ====================================

model CustomDomain {
  id          String   @id @default(cuid())
  domain      String   @unique
  siteId      String   @unique
  
  // DNS verification
  verified    Boolean  @default(false)
  txtRecord   String?  // For domain verification
  
  // SSL
  sslEnabled  Boolean  @default(false)
  sslIssuedAt DateTime?
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  site        UserSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  
  @@map("custom_domains")
  @@index([domain])
  @@index([verified])
}

model Webhook {
  id          String   @id @default(cuid())
  siteId      String
  url         String
  events      String[] // ["page_view", "link_click", "form_submit"]
  secret      String   // For signature verification
  
  // Status
  isActive    Boolean  @default(true)
  lastError   String?
  lastSuccess DateTime?
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  site        UserSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  
  @@map("webhooks")
  @@index([siteId])
  @@index([isActive])
}
